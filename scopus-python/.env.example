# brainmap.ro scraping credentials — COPY this file to `.env` (same dir) and fill in real values.
# `.env` is gitignored (see repo .gitignore: `.env`, `.env.*`); never commit real credentials.
# The scraper reads these via environment/file; the password is never printed, logged, or committed.
BRAINMAP_USER=
BRAINMAP_PASS=
