# Local Spring profile. Use "postgres" to enable application-postgres.properties.
SPRING_PROFILES_ACTIVE=postgres

# Mongo canonical/ingest source (adjust db name as needed).
SPRING_MONGODB_URI=mongodb://localhost:27017/scholardex

# Postgres reporting-read store.
POSTGRES_URL=jdbc:postgresql://localhost:5432/core
POSTGRES_USER=core
POSTGRES_PASSWORD=core

# Read-store selector for migrated reporting surfaces.
# Keep "mongo" by default; switch to "postgres" only after H22 projection + gate checks.
APP_REPORTING_READ_STORE=mongo

# Optional H22 projector/gate toggles.
H22_PROJECTION_ENABLED=false
H22_PROJECTION_DRY_RUN=false
H22_DUAL_READ_GATE_P95_RATIO_THRESHOLD=1.2

# WoS pipeline optimization (ingest -> facts -> projections).
# Recommended starting values for local cutover/rebuild:
# - keep chunk sizes at 1000 first
# - increase identity LRU if you still see identity+filter spikes
CORE_WOS_OPTIMIZATION_FACT_CHUNK_SIZE=1000
CORE_WOS_OPTIMIZATION_INGEST_PERSIST_BATCH_SIZE=1000
CORE_WOS_OPTIMIZATION_PROJECTION_WRITE_CHUNK_SIZE=1000
CORE_WOS_OPTIMIZATION_IDENTITY_LRU_MAX_SIZE=200000
CORE_WOS_OPTIMIZATION_PREFLIGHT_INDEXES_ENABLED=true
CORE_WOS_OPTIMIZATION_TELEMETRY_HEARTBEAT_INTERVAL=10000
CORE_WOS_OPTIMIZATION_SLOW_CHUNK_THRESHOLD_MS=2000

# Elsevier Scopus — consumed by the scopus-python container. Rotate the key that used to be committed
# in application.properties (it is public in git history).
SCOPUS_API_KEY=replace-me
# Optional institutional token (campus-IP entitlement usually suffices without it).
SCOPUS_INST_TOKEN=
# Internal address of the scopus-python container (docker-compose default).
SCOPUS_PYTHON_BASE_URL=scopus-python:65008

# OpenAlex polite-pool contact. Use a dedicated institutional service mailbox (not a personal
# address) so attribution is stable. Empty = anonymous common pool (slower); when the variable is
# entirely unset (bare-metal runs), Spring falls back to admin.email.
OPENALEX_MAILTO=

# Bootstrap admin account (seeded only when the user collection is empty) and the initial password
# assigned to accounts provisioned by staff import / group creation. REQUIRED by docker-compose —
# it refuses to start with these unset. Pick strong values for any shared deployment.
ADMIN_EMAIL=admin@example.org
ADMIN_PASSWORD=replace-me
USER_DEFAULT_PASSWORD=replace-me

# Optional Keycloak institutional login.
# Leave blank to keep only local account login enabled.
KEYCLOAK_ISSUER_URI=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=
KEYCLOAK_SCOPES=openid,profile,email
